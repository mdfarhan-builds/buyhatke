# Development settings only. Copy to .env; never commit credentials or real feeds.
# The default application requires neither retailer credentials nor databases.

# On Vercel, set this to the ACTUAL public Render API origin for comparisons.
# Without it Vercel can show the UI, but API requests explicitly return HTTP 503.
# It is not needed for local development. Redeploy after changing it.
# PRICEWISE_API_URL=https://your-actual-api-service.onrender.com

# Optional: absolute path to an operator-provided, authorized normalized JSON feed.
# See backend/README.md for its schema and verification requirements.
# PRICEWISE_FEED_PATH=/absolute/path/to/authorized-feed.json

PRICEWISE_ENVIRONMENT=development
PRICEWISE_MAX_AGE_SECONDS=900
PRICEWISE_CACHE_TTL_SECONDS=30
PRICEWISE_RATE_LIMIT_PER_MINUTE=30
PRICEWISE_ALLOWED_ORIGINS=http://localhost:3000

# Optional local services: set this password before `docker compose up -d`.
POSTGRES_DB=pricewise
POSTGRES_USER=pricewise
POSTGRES_PASSWORD=replace-with-local-development-password

# Enable these only after starting the optional services. Keep the password in sync.
# PRICEWISE_DATABASE_URL=postgresql+asyncpg://pricewise:replace-with-local-development-password@127.0.0.1:5432/pricewise
# PRICEWISE_REDIS_URL=redis://127.0.0.1:6379/0
